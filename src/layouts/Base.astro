---
import '../styles/global.css';
import displayFont from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import bodyFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { locales, switchLocalePath, useTranslations, withBase, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const { lang, title, description, image = '/assets/og/og-default.png', type = 'website', publishedTime, noindex = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} | 恋は盲目`;
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(image), Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'en'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme + language memory before first paint (no flash) -->
    <script is:inline define:vars={{ lang }}>
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        localStorage.setItem('lang', lang);
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="meta sr-only z-50 bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >{t('nav.skip')}</a
    >
    <Nav lang={lang} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

  </body>
</html>
