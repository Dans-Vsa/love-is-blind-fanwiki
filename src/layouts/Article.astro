---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Sfx from '../components/Sfx.astro';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  headings: MarkdownHeading[];
  kicker: string;
  sfx?: string;
  kanji?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { lang, title, description, headings, kicker, sfx = 'ドン', kanji, type = 'article', publishedTime } = Astro.props;
---

<Base lang={lang} title={title} description={description} type={type} publishedTime={publishedTime}>
  <header class="relative overflow-hidden border-b-[3px] border-ink bg-raised">
    <div class="tone-fade pointer-events-none absolute inset-0 opacity-15" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
      <slot name="breadcrumb" />
      <p class="meta mt-4 text-tone-60">{kicker}</p>
      <h1 class="mt-3 max-w-4xl font-display text-[clamp(2.4rem,6vw,4.6rem)] leading-[0.95]">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed">{description}</p>
      <slot name="meta" />
      {kanji && <span aria-hidden="true" lang="ja" class="pointer-events-none absolute right-4 -bottom-10 hidden font-display text-[12rem] leading-none opacity-10 md:block">{kanji}</span>}
      <Sfx text={sfx} class="absolute top-6 right-6 hidden text-6xl lg:block" rotate={10} accent />
    </div>
  </header>

  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_17rem]">
    <article class="prose-manga min-w-0">
      <slot />
    </article>
    <aside class="order-first lg:order-none">
      <Toc lang={lang} headings={headings} />
      <slot name="aside" />
    </aside>
  </div>
</Base>
