---
import type { CollectionEntry } from 'astro:content';
import { dateFormat, localePath, useTranslations, type Locale } from '../i18n';
import { entrySlug, readingMinutes } from '../lib/content';
import Sfx from './Sfx.astro';

interface Props { lang: Locale; entry: CollectionEntry<'blog'>; index?: number }
const { lang, entry, index = 0 } = Astro.props;
const t = useTranslations(lang);
---

<article class="panel panel-link reveal hover-jitter relative flex h-full flex-col overflow-hidden" style={`--i:${index}`}>
  <div class="tone-light relative h-28 border-b-[3px] border-ink" aria-hidden="true">
    <Sfx text={entry.data.sfx} class="absolute top-3 left-4 text-6xl" rotate={-8} />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="meta text-tone-60">
      <time datetime={entry.data.date.toISOString()}>{dateFormat(lang, entry.data.date)}</time> · {readingMinutes(entry)} {t('blog.minutes')}
    </p>
    <h3 class="mt-2 font-display text-2xl">
      <a href={localePath(lang, `blog/${entrySlug(entry.id)}`)} class="no-underline after:absolute after:inset-0 after:content-['']">
        {entry.data.title}
      </a>
    </h3>
    <p class="mt-3 leading-snug">{entry.data.description}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-4" aria-label="Tags">
      {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>
