---
// Animated downpour over the hero illustration. The wind follows the pointer.
// Pauses off-screen and when the tab is hidden; never runs with reduced motion.
import { useTranslations, type Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<canvas class="rain-canvas pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
<button
  type="button"
  class="rain-toggle meta absolute right-3 bottom-3 z-10 hidden border-2 border-[#f4f1ea] bg-[#0b0b0b] px-2 py-1 text-[#f4f1ea] hover:bg-[#f4f1ea] hover:text-[#0b0b0b]"
  aria-pressed="true"
>
  <span aria-hidden="true">ザア ☂</span>
  <span class="sr-only">{t('rain.toggle')}</span>
</button>

<script>
  document.querySelectorAll<HTMLCanvasElement>('.rain-canvas').forEach((canvas) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const host = canvas.parentElement!;
    const toggle = host.querySelector<HTMLButtonElement>('.rain-toggle')!;
    const ctx = canvas.getContext('2d')!;
    toggle.classList.remove('hidden');

    type Drop = { x: number; y: number; len: number; speed: number; alpha: number };
    let drops: Drop[] = [];
    let w = 0;
    let h = 0;
    let wind = -0.25; // current slant, eased toward target
    let targetWind = -0.25;
    let running = true;
    let visible = false;
    let frame = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((w * h) / 2600);
      drops = Array.from({ length: count }, () => ({
        x: Math.random() * w * 1.4 - w * 0.2,
        y: Math.random() * h,
        len: 10 + Math.random() * 22,
        speed: 7 + Math.random() * 9,
        alpha: 0.25 + Math.random() * 0.5,
      }));
    };

    const tick = () => {
      frame = 0;
      if (!running || !visible || document.hidden) return;
      wind += (targetWind - wind) * 0.05;
      ctx.clearRect(0, 0, w, h);
      ctx.lineWidth = 1.4;
      ctx.lineCap = 'round';
      for (const d of drops) {
        d.y += d.speed;
        d.x += d.speed * wind;
        if (d.y > h) { d.y = -d.len; d.x = Math.random() * w * 1.4 - w * 0.2; }
        ctx.strokeStyle = `rgba(244, 241, 234, ${d.alpha})`;
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(d.x + d.len * wind, d.y + d.len);
        ctx.stroke();
      }
      frame = requestAnimationFrame(tick);
    };
    const start = () => { if (!frame) frame = requestAnimationFrame(tick); };

    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      targetWind = ((e.clientX - r.left) / r.width - 0.5) * 1.2;
    });
    host.addEventListener('pointerleave', () => { targetWind = -0.25; });

    toggle.addEventListener('click', () => {
      running = !running;
      toggle.setAttribute('aria-pressed', String(running));
      if (running) start();
      else ctx.clearRect(0, 0, w, h);
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    }).observe(host);
    document.addEventListener('visibilitychange', start);
    new ResizeObserver(resize).observe(canvas);
    resize();
  });
</script>
