---
// "Rank it like Ibuki": reorder four things by importance (pointer drag or the
// ▲/▼ buttons), then check. Ibuki's answer: the confession beats everything.
import Sfx from './Sfx.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const id = lang === 'id';

const items = [
  { key: 'ceremony', icon: '卒', label: id ? 'Menyiapkan upacara kelulusan' : 'Prepare the graduation ceremony' },
  { key: 'wallet', icon: '盗', label: id ? 'Selamat dari perampok' : 'Survive the robber' },
  { key: 'earth', icon: '球', label: id ? 'Menyelamatkan planet Bumi' : 'Save planet Earth' },
  { key: 'confess', icon: '恋', label: id ? 'Menyatakan cinta kepada Yuri' : 'Confess to Yuri' },
];
---

<section class="game panel relative overflow-hidden p-5 sm:p-8" data-game aria-labelledby="game-title">
  <div class="tone-fade pointer-events-none absolute inset-x-0 top-0 h-24 opacity-15" aria-hidden="true"></div>
  <div class="relative grid gap-8 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="panel-caption">Mini game</p>
      <h2 id="game-title" class="mt-3 font-display text-3xl sm:text-4xl">{t('game.title')}</h2>
      <p class="mt-3 max-w-md text-lg">{t('game.lede')}</p>
      <p class="meta mt-4 text-tone-60">{t('game.drag')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" class="btn btn-primary" data-check>{t('game.check')}</button>
        <button type="button" class="btn btn-ghost" data-shuffle>{t('game.reset')}</button>
      </div>
    </div>

    <div class="relative">
      <ol class="space-y-3" data-list>
        {
          items.map((it) => (
            <li
              class="game-item flex items-center gap-3 border-[3px] border-ink bg-raised p-3 shadow-[4px_4px_0_var(--ink)] select-none"
              data-key={it.key}
            >
              <span class="game-rank grid size-9 shrink-0 place-items-center bg-ink font-display text-lg text-paper"></span>
              <span class="-my-3 grid w-8 cursor-grab touch-none place-items-center self-stretch text-xl text-tone-60 active:cursor-grabbing" data-handle aria-hidden="true">⠿</span>
              <span class="flex-1 font-semibold leading-tight">
                <span aria-hidden="true" lang="ja" class:list={['mr-2 inline-grid size-8 place-items-center border-2 border-ink align-middle text-base font-bold', it.key === 'confess' && 'border-accent text-accent']}>{it.icon}</span>{it.label}
              </span>
              <span class="flex flex-col gap-1">
                <button type="button" class="game-btn border-2 border-ink px-2 leading-5 hover:bg-tone-10" data-up aria-label={`${t('game.up')}: ${it.label}`}>▲</button>
                <button type="button" class="game-btn border-2 border-ink px-2 leading-5 hover:bg-tone-10" data-down aria-label={`${t('game.down')}: ${it.label}`}>▼</button>
              </span>
            </li>
          ))
        }
      </ol>

      <div class="game-result mt-5 hidden" role="status" aria-live="polite" data-result>
        <div class="bubble px-8 py-6">
          <p class="font-display text-2xl" data-result-title></p>
          <p class="mt-2" data-result-body></p>
        </div>
      </div>
      <div class="pointer-events-none absolute inset-0 overflow-visible" data-burst aria-hidden="true"></div>
      <Sfx text="ドキドキ" class="absolute -top-10 right-0 hidden text-5xl sm:block" rotate={10} accent />
    </div>
  </div>

  <template data-i18n
    data-win-title={t('game.win.title')} data-win-body={t('game.win.body')}
    data-lose-title={t('game.lose.title')} data-lose-body={t('game.lose.body')}></template>
</section>

<style>
  .game-item { transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .game-item.dragging { transform: scale(1.03) rotate(-1deg); box-shadow: 8px 8px 0 var(--ink); z-index: 5; position: relative; }
  .game-item[data-key='confess'] .game-rank { background: var(--accent); color: var(--accent-ink); }
  .game.won .game-item[data-key='confess'] { outline: 3px solid var(--accent); outline-offset: 3px; }
  .heart-piece { position: absolute; font-size: 1.4rem; color: var(--accent); animation: heart-fly 0.9s ease-out forwards; }
  @keyframes heart-fly {
    from { transform: translate(0, 0) scale(0.6) rotate(0); opacity: 1; }
    to { transform: translate(var(--dx), var(--dy)) scale(1.3) rotate(var(--rot)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .heart-piece { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-game]').forEach((root) => {
    const list = root.querySelector<HTMLOListElement>('[data-list]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const burst = root.querySelector<HTMLElement>('[data-burst]')!;
    const i18n = root.querySelector<HTMLTemplateElement>('[data-i18n]')!.dataset;
    const items = () => [...list.querySelectorAll<HTMLElement>('.game-item')];

    const renumber = () => {
      items().forEach((li, i) => {
        li.querySelector('.game-rank')!.textContent = String(i + 1);
      });
      result.classList.add('hidden');
      root.classList.remove('won');
    };

    const move = (li: HTMLElement, dir: -1 | 1) => {
      const sib = dir < 0 ? li.previousElementSibling : li.nextElementSibling;
      if (!sib) return;
      if (dir < 0) list.insertBefore(li, sib);
      else list.insertBefore(sib, li);
      renumber();
      li.querySelector<HTMLButtonElement>(dir < 0 ? '[data-up]' : '[data-down]')?.focus();
    };

    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      const li = btn?.closest<HTMLElement>('.game-item');
      if (!btn || !li) return;
      move(li, btn.hasAttribute('data-up') ? -1 : 1);
    });

    // Pointer drag (mouse + touch) from the ⠿ handle, so the rest of the card still scrolls the page on touch.
    let dragging: HTMLElement | null = null;
    list.addEventListener('pointerdown', (e) => {
      const handle = (e.target as HTMLElement).closest('[data-handle]');
      const li = handle?.closest<HTMLElement>('.game-item');
      if (!li) return;
      dragging = li;
      li.classList.add('dragging');
      li.setPointerCapture(e.pointerId);
    });
    list.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const over = items().find((li) => {
        if (li === dragging) return false;
        const r = li.getBoundingClientRect();
        return e.clientY > r.top && e.clientY < r.bottom;
      });
      if (!over) return;
      const r = over.getBoundingClientRect();
      list.insertBefore(dragging, e.clientY < r.top + r.height / 2 ? over : over.nextElementSibling);
      renumber();
    });
    const end = () => {
      dragging?.classList.remove('dragging');
      dragging = null;
    };
    list.addEventListener('pointerup', end);
    list.addEventListener('pointercancel', end);

    const shuffle = () => {
      const arr = items();
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      // never start with the "right" answer on top
      if (arr[0].dataset.key === 'confess') arr.push(arr.shift()!);
      arr.forEach((li) => list.append(li));
      renumber();
    };

    const heartBurst = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const rect = burst.getBoundingClientRect();
      const top = items()[0].getBoundingClientRect();
      for (let i = 0; i < 18; i++) {
        const h = document.createElement('span');
        h.className = 'heart-piece';
        h.textContent = '♥';
        h.style.left = `${top.left - rect.left + top.width / 2}px`;
        h.style.top = `${top.top - rect.top + top.height / 2}px`;
        const a = (Math.PI * 2 * i) / 18;
        h.style.setProperty('--dx', `${Math.cos(a) * (80 + Math.random() * 90)}px`);
        h.style.setProperty('--dy', `${Math.sin(a) * (60 + Math.random() * 70)}px`);
        h.style.setProperty('--rot', `${Math.random() * 120 - 60}deg`);
        burst.append(h);
        setTimeout(() => h.remove(), 1000);
      }
    };

    root.querySelector('[data-check]')!.addEventListener('click', () => {
      const won = items()[0].dataset.key === 'confess';
      root.classList.toggle('won', won);
      result.querySelector('[data-result-title]')!.textContent = won ? i18n.winTitle! : i18n.loseTitle!;
      result.querySelector('[data-result-body]')!.textContent = won ? i18n.winBody! : i18n.loseBody!;
      result.classList.remove('hidden');
      if (won) heartBurst();
    });
    root.querySelector('[data-shuffle]')!.addEventListener('click', shuffle);

    shuffle();
  });
</script>
