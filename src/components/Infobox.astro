---
import type { Character } from '../data/characters';
import { useTranslations, type Locale } from '../i18n';
import Unverified from './Unverified.astro';
import Silhouette from './Silhouette.astro';
import Picture from './Picture.astro';

interface Props { lang: Locale; character: Character; index?: number }
const { lang, character: c, index = 0 } = Astro.props;
const t = useTranslations(lang);
---

<article id={c.id} class="panel reveal scroll-mt-24" style={`--i:${index}`} aria-labelledby={`${c.id}-name`}>
  <header class="flex items-center justify-between gap-3 bg-ink px-4 py-2 text-paper">
    <h3 id={`${c.id}-name`} class="!m-0 font-display text-xl">{c.name}</h3>
    <span class="font-display text-lg" lang="ja">{c.jp}</span>
  </header>
  <div class="grid sm:grid-cols-[9rem_1fr]">
    <div class="tone-light grid place-items-center border-b-[3px] border-ink p-3 sm:border-r-[3px] sm:border-b-0">
      {
        c.image ? (
          <figure class="ink-figure m-0" tabindex="0">
            <Picture
              name={c.image.name}
              width={c.image.width}
              height={c.image.height}
              alt={lang === 'id' ? `${c.name}, artwork karakter resmi dari anime` : `${c.name}, official character art from the anime`}
              class="h-56 w-auto"
            />
            <figcaption class="sr-only">© Tatsuki Fujimoto / Shueisha · Tatsuki Fujimoto 17-26</figcaption>
          </figure>
        ) : (
          <Silhouette id={c.id} class="h-32 w-auto" />
        )
      }
    </div>
    <div class="p-4">
      <dl class="grid grid-cols-[auto_1fr] text-sm">
        <dt class="meta border-b border-ink bg-tone-10 px-2 py-1.5">{t('infobox.role')}</dt>
        <dd class="border-b border-ink px-2 py-1.5">{c.role[lang]}</dd>
        <dt class="meta border-b border-ink bg-tone-10 px-2 py-1.5">{t('infobox.position')}</dt>
        <dd class="border-b border-ink px-2 py-1.5">{c.position[lang]}</dd>
        <dt class="meta border-b border-ink bg-tone-10 px-2 py-1.5">{t('infobox.jp')}</dt>
        <dd class="border-b border-ink px-2 py-1.5" lang="ja">{c.jp}</dd>
        <dt class="meta border-b border-ink bg-tone-10 px-2 py-1.5">{t('infobox.relations')}</dt>
        <dd class="border-b border-ink px-2 py-1.5">{c.relations[lang]}</dd>
        {
          c.va && (
            <>
              <dt class="meta bg-tone-10 px-2 py-1.5">{t('infobox.va')}</dt>
              <dd class="px-2 py-1.5">
                JP: {c.va.ja}
                {c.va.en && (
                  <>
                    <br />
                    EN: {c.va.en}
                  </>
                )}
              </dd>
            </>
          )
        }
      </dl>
      <p class="mt-3 leading-relaxed">{c.description[lang]}</p>
      {
        c.unverified && (
          <p class="mt-2 text-sm text-tone-60">
            <Unverified lang={lang} /> {c.unverified[lang]}
          </p>
        )
      }
    </div>
  </div>
</article>
