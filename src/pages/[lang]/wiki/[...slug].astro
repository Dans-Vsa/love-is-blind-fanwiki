---
import { getCollection, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { dateFormat, localePath, useTranslations, type Locale } from '../../../i18n';
import { entryLang, entrySlug, getWiki } from '../../../lib/content';
import { sourceById } from '../../../data/sources';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry) => ({
    params: { lang: entryLang(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { Content, headings } = await render(entry);
const all = await getWiki(lang);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
const pageSources = entry.data.sources.map(sourceById).filter((s) => !!s);
---

<Article
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  kicker={`Wiki · Panel ${String(entry.data.order).padStart(2, '0')}`}
  kanji={entry.data.kanji}
  type="website"
>
  <nav slot="breadcrumb" aria-label="Breadcrumb" class="meta">
    <a href={localePath(lang)}>{t('nav.home')}</a> / <a href={localePath(lang, 'wiki')}>{t('nav.wiki')}</a> / <span aria-current="page">{entry.data.title}</span>
  </nav>
  <div slot="meta" class="mt-5 flex flex-wrap items-center gap-3">
    <span class="meta text-tone-60">{t('wiki.updated')}: <time datetime={entry.data.updated.toISOString()}>{dateFormat(lang, entry.data.updated)}</time></span>
    {entry.data.spoilers && <span class="meta bg-accent px-2 py-0.5 text-white">{t('wiki.spoilers')}</span>}
  </div>

  <Content />

  {
    pageSources.length > 0 && (
      <section aria-labelledby="page-sources" class="mt-14 border-t-[3px] border-ink pt-6">
        <h2 id="page-sources" class="!mt-0 !border-0 !pb-0 !text-2xl">{t('wiki.sources')}</h2>
        <ol class="mt-3 text-sm">
          {pageSources.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">{s.title}</a> — {s.publisher}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <nav class="mt-14 grid gap-[var(--gutter)] sm:grid-cols-2" aria-label="Wiki pages">
    {prev ? (
      <a class="panel panel-link block p-4 no-underline" href={localePath(lang, `wiki/${entrySlug(prev.id)}`)}>
        <span class="meta text-tone-60">← {String(prev.data.order).padStart(2, '0')}</span>
        <span class="mt-1 block font-display text-xl">{prev.data.title}</span>
      </a>
    ) : <span />}
    {next && (
      <a class="panel panel-link block p-4 text-right no-underline" href={localePath(lang, `wiki/${entrySlug(next.id)}`)}>
        <span class="meta text-tone-60">{String(next.data.order).padStart(2, '0')} →</span>
        <span class="mt-1 block font-display text-xl">{next.data.title}</span>
      </a>
    )}
  </nav>
</Article>
