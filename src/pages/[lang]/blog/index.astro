---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Sfx from '../../../components/Sfx.astro';
import { getStaticLocalePaths, useTranslations, type Locale } from '../../../i18n';
import { getPosts } from '../../../lib/content';

export const getStaticPaths = getStaticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={t('blog.title')} description={t('blog.lede')}>
  <header class="relative overflow-hidden border-b-[3px] border-ink bg-ink text-paper">
    <div class="rain pointer-events-none absolute inset-0 animate-rain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <p class="meta text-tone-30">恋は盲目 · Fanblog</p>
      <h1 class="mt-3 font-display text-[clamp(3rem,8vw,6rem)] leading-none">{t('blog.title')}</h1>
      <p class="mt-4 max-w-2xl text-lg">{t('blog.lede')}</p>
      <Sfx text="ペラ" class="absolute right-8 bottom-6 hidden text-8xl [-webkit-text-stroke-color:var(--paper)] md:block" rotate={-10} />
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <ul class="grid gap-[var(--gutter)] md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <li><PostCard lang={lang} entry={p} index={i} /></li>)}
    </ul>
  </section>
</Base>
