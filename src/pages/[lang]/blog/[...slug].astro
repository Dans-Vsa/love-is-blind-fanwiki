---
import { getCollection, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { dateFormat, localePath, useTranslations, type Locale } from '../../../i18n';
import { entryLang, entrySlug, readingMinutes } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { lang: entryLang(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { Content, headings } = await render(entry);
---

<Article
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  kicker={`${t('blog.title')} · ${entry.data.tags.join(' · ')}`}
  sfx={entry.data.sfx}
  publishedTime={entry.data.date}
>
  <nav slot="breadcrumb" aria-label="Breadcrumb" class="meta">
    <a href={localePath(lang)}>{t('nav.home')}</a> / <a href={localePath(lang, 'blog')}>{t('nav.blog')}</a> / <span aria-current="page">{entry.data.title}</span>
  </nav>
  <p slot="meta" class="meta mt-5 text-tone-60">
    {t('blog.by')} {entry.data.author} · <time datetime={entry.data.date.toISOString()}>{dateFormat(lang, entry.data.date)}</time> · {readingMinutes(entry)} {t('blog.minutes')}
    {entry.data.spoilers && <span class="ml-2 bg-accent px-2 py-0.5 text-accent-ink">{t('wiki.spoilers')}</span>}
  </p>

  <Content />

  <p class="mt-14"><a class="btn btn-ghost" href={localePath(lang, 'blog')}>← {t('blog.back')}</a></p>
</Article>
