---
import Base from '../../layouts/Base.astro';
import { getStaticLocalePaths, useTranslations, type Locale } from '../../i18n';
import { sources } from '../../data/sources';
import { assetCredits } from '../../data/credits';

export const getStaticPaths = getStaticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const kinds = {
  official: lang === 'id' ? 'Resmi' : 'Official',
  reference: lang === 'id' ? 'Referensi' : 'Reference',
  review: lang === 'id' ? 'Ulasan' : 'Review',
  database: 'Database',
} as const;
---

<Base lang={lang} title={t('refs.title')} description={t('refs.lede')}>
  <header class="border-b-[3px] border-ink bg-raised">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <p class="meta text-tone-60">恋は盲目 · {t('nav.references')}</p>
      <h1 class="mt-3 font-display text-[clamp(2.6rem,7vw,5rem)] leading-none">{t('refs.title')}</h1>
      <p class="mt-4 max-w-2xl text-lg">{t('refs.lede')}</p>
    </div>
  </header>

  <div class="mx-auto max-w-7xl space-y-14 px-4 py-10 sm:px-6">
    <section aria-labelledby="sources-title">
      <h2 id="sources-title" class="mb-6 font-display text-3xl">{t('refs.sources')}</h2>
      <ol class="grid gap-[var(--gutter)] md:grid-cols-2">
        {
          sources.map((s, i) => (
            <li id={`src-${s.id}`} class="panel reveal p-4" style={`--i:${i % 4}`}>
              <p class="meta flex flex-wrap gap-2 text-tone-60">
                <span class="tag">{kinds[s.kind]}</span>
                <span>{s.publisher}</span>
              </p>
              <p class="mt-2 font-semibold leading-snug">
                <a href={s.url} rel="noopener" target="_blank" class="decoration-accent">{s.title}</a>
              </p>
              {s.note && <p class="mt-1 text-sm text-tone-60">{s.note}</p>}
              <p class="meta mt-2 text-tone-60">{t('refs.accessed')}: {s.accessed}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="assets-title">
      <h2 id="assets-title" class="mb-6 font-display text-3xl">{t('refs.assets')}</h2>
      <div class="panel overflow-x-auto">
        <table class="w-full min-w-[44rem] border-collapse text-sm">
          <thead class="bg-ink text-paper">
            <tr>
              {['Asset', lang === 'id' ? 'Pembuat' : 'Author', lang === 'id' ? 'Lisensi' : 'License', lang === 'id' ? 'Sumber' : 'Source'].map((h) => (
                <th scope="col" class="meta px-3 py-2 text-left">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              assetCredits.map((a) => (
                <tr class="border-t-2 border-ink align-top">
                  <td class="px-3 py-2">
                    {a.asset}
                    <br />
                    <code class="text-xs text-tone-60">{a.file}</code>
                    {a.note && <p class="mt-1 text-xs text-tone-60">{a.note}</p>}
                  </td>
                  <td class="px-3 py-2">{a.author}</td>
                  <td class="px-3 py-2">{a.licenseUrl ? <a href={a.licenseUrl} rel="noopener license" target="_blank">{a.license}</a> : a.license}</td>
                  <td class="px-3 py-2 break-all">{a.source.startsWith('http') ? <a href={a.source} rel="noopener" target="_blank">{a.source.replace(/^https?:\/\//, '')}</a> : a.source}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel tone-light p-6">
      <p class="max-w-3xl bg-raised p-4 leading-relaxed">{t('footer.disclaimer')}</p>
    </section>
  </div>
</Base>
