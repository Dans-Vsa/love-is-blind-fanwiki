---
// Root: pick a language. Saved choice > browser language > English.
import { withBase } from '../i18n';
const en = withBase('/en/');
const id = withBase('/id/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Love is Blind — Fan Wiki | 恋は盲目</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(en, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(en, Astro.site)} />
    <link rel="alternate" hreflang="id" href={new URL(id, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline define:vars={{ en, id }}>
      let lang = null;
      try { lang = localStorage.getItem('lang'); } catch {}
      if (lang !== 'en' && lang !== 'id') {
        const prefs = navigator.languages || [navigator.language || 'en'];
        lang = prefs.some((l) => /^(id|ms)\b/i.test(l)) ? 'id' : 'en';
      }
      location.replace(lang === 'id' ? id : en);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${en}`} /></noscript>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0b0b0b; color: #f4f1ea; font: 16px/1.5 ui-monospace, monospace; }
      a { color: #ff3b4e; }
    </style>
  </head>
  <body>
    <p><a href={en}>English</a> · <a href={id}>Bahasa Indonesia</a></p>
  </body>
</html>
